rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? getUserDoc(request.auth.uid).data.role
          : null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'ADMIN') ||
        getUserRole() == 'ADMIN'
      );
    }

    function isClient() {
      return isAuthenticated() && getUserRole() == 'CLIENT';
    }

    function isTrainer() {
      return isAuthenticated() && getUserRole() == 'TRAINER';
    }

    function isUserActive(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             getUserDoc(userId).data.status != 'SUSPENDED';
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. users Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Clients can only read their own user record; Admins can read all; Trainers can be read publicly for booking/discovery
      allow read: if isOwner(userId) || isAdmin() || (resource.data.role == 'TRAINER');

      // Section 2 & 4: Public users cannot self-assign ADMIN role
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'CLIENT' ||
        request.resource.data.role == 'TRAINER'
      );

      // Section 4: Users cannot modify their own role or status
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
      );

      allow delete: if isAdmin();

      // User Settings Subcollection (Notification Preferences, Privacy)
      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Deletion Requests & Audits (Statutory Compliance)
    // ─────────────────────────────────────────────────────────────────────────
    match /deletion_requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /deletion_audits/{auditId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions / Admin SDK only
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. client_profiles Collection (Strictly private to Client Owner & Admin)
    // ─────────────────────────────────────────────────────────────────────────
    match /client_profiles/{clientId} {
      allow read: if isOwner(clientId) || isAdmin();
      allow write: if isOwner(clientId) || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. trainer_profiles Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /trainer_profiles/{trainerId} {
      // Section 6: Public/clients can only view APPROVED and active trainers
      allow read: if isAdmin() || isOwner(trainerId) || (
        resource.data.verificationStatus == 'APPROVED' &&
        resource.data.isActive == true
      );

      // Trainers start with PENDING verification status
      allow create: if isOwner(trainerId) && (
        !('verificationStatus' in request.resource.data) ||
        request.resource.data.verificationStatus == 'PENDING'
      );

      // Section 4 & 6: Only admins can approve or modify verification fields, approval status, and trainer category
      allow update: if isAdmin() || (
        isOwner(trainerId) &&
        (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == resource.data.verificationStatus) &&
        (!('category' in request.resource.data) || request.resource.data.category == resource.data.category) &&
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == resource.data.approvedAt) &&
        (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == resource.data.approvedBy) &&
        (!('adminReviewNotes' in request.resource.data) || request.resource.data.adminReviewNotes == resource.data.adminReviewNotes)
      );

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. cities Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /cities/{cityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. training_plans Collection
    // Platform fixed packages and Advanced Trainer custom plans
    // ─────────────────────────────────────────────────────────────────────────
    match /training_plans/{planId} {
      // Authenticated users can view approved active plans; Admins can view all;
      // and trainers can view their own pending or published custom plans.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.isActive == true && (!('isApproved' in resource.data) || resource.data.isApproved == true)) ||
        (resource.data.trainerId == request.auth.uid)
      );

      // Only Admins or approved Advanced Trainers can create custom plans
      // Advanced Trainer custom plans MUST start with isApproved == false (pending separate Admin review)
      allow create: if isAuthenticated() && (
        isAdmin() || (
          request.resource.data.trainerId == request.auth.uid &&
          request.resource.data.isApproved == false &&
          exists(/databases/$(database)/documents/trainer_profiles/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/trainer_profiles/$(request.auth.uid)).data.category == 'ADVANCED_TRAINER' ||
           get(/databases/$(database)/documents/trainer_profiles/$(request.auth.uid)).data.category == 'ADVANCED') &&
          get(/databases/$(database)/documents/trainer_profiles/$(request.auth.uid)).data.verificationStatus == 'APPROVED'
        )
      );

      // Only Admins can approve (set isApproved == true) or modify fixed platform plans.
      // Trainers can update their unapproved plans without self-approving.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.trainerId == request.auth.uid &&
        request.resource.data.trainerId == request.auth.uid &&
        (!('isApproved' in request.resource.data) || request.resource.data.isApproved == resource.data.isApproved)
      );

      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.trainerId == request.auth.uid
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. bookings Collection (Strict Participant & Admin Access Only)
    // ─────────────────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Clients can only read their own bookings; Trainers can only read their assigned bookings
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isAdmin()
      );

      // Section 5: Gender Matching Enforcement & Section 6: Approved Trainer
      allow create: if isAuthenticated() &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.clientGender == request.resource.data.trainerGender &&
        exists(/databases/$(database)/documents/trainer_profiles/$(request.resource.data.trainerId)) &&
        get(/databases/$(database)/documents/trainer_profiles/$(request.resource.data.trainerId)).data.verificationStatus == 'APPROVED' &&
        get(/databases/$(database)/documents/trainer_profiles/$(request.resource.data.trainerId)).data.isActive == true;

      // Clients and trainers can update session notes/rescheduling/cancellations; Clients cannot self-confirm
      allow update: if isAuthenticated() && (
        isAdmin() || (
          (resource.data.clientId == request.auth.uid || resource.data.trainerId == request.auth.uid) &&
          request.resource.data.clientId == resource.data.clientId &&
          request.resource.data.trainerId == resource.data.trainerId &&
          (!('packagePrice' in request.resource.data) || request.resource.data.packagePrice == resource.data.packagePrice) &&
          (!('status' in request.resource.data) ||
           request.resource.data.status == resource.data.status ||
           request.resource.data.status == 'CANCELLED' ||
           request.resource.data.status == 'CANCELLED_CLIENT_EARLY' ||
           request.resource.data.status == 'RESCHEDULED' ||
           resource.data.trainerId == request.auth.uid)
        )
      );

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 7. payments Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        isAdmin()
      );
      // Clients may create INITIATED orders; SUCCESS and credit-granting must be performed by admin or Cloud Functions
      allow create: if isAuthenticated() &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.status == 'INITIATED';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 8. session_credits Collection (Section 8: Double-entry credit ledger)
    // ─────────────────────────────────────────────────────────────────────────
    match /session_credits/{clientId} {
      allow read: if isOwner(clientId) || isAdmin();
      // Session credit modifications must be performed by admin or trusted backend
      allow write: if isAdmin();

      match /transactions/{txId} {
        allow read: if isOwner(clientId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 9. trainer_availability Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /trainer_availability/{availId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (
        isAuthenticated() && (
          (resource != null && resource.data.trainerId == request.auth.uid) ||
          (request.resource != null && request.resource.data.trainerId == request.auth.uid)
        )
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 10. reviews Collection (Verified Session Eligibility Required)
    // ─────────────────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if resource.data.isPublic == true ||
                     isOwner(resource.data.clientId) ||
                     isOwner(resource.data.trainerId) ||
                     isAdmin();
      // Only the client who completed the booking can submit a review
      allow create: if isAuthenticated() &&
                    request.resource.data.clientId == request.auth.uid &&
                    exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)) &&
                    get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientId == request.auth.uid &&
                    get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'COMPLETED';
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(resource.data.clientId) &&
          request.resource.data.clientId == resource.data.clientId &&
          request.resource.data.bookingId == resource.data.bookingId
        )
      );
      allow delete: if isAdmin();
    }

    // Review Reports (Abuse / Harassment Flagging)
    match /review_reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 11. notifications Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, delete: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 12. purchased_packages Collection (Admin SDK / Cloud Functions Managed)
    // ─────────────────────────────────────────────────────────────────────────
    match /purchased_packages/{packageId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin(); // Package activation and balances must be managed by Cloud Functions
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 13. platform_settings Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /platform_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 14. slot_locks Collection (Double-booking protection & temporary reservations)
    // ─────────────────────────────────────────────────────────────────────────
    match /slot_locks/{lockId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        (resource != null && (resource.data.clientId == request.auth.uid || resource.data.trainerId == request.auth.uid)) ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Support Tickets & Complaints (Strict Client Ownership & Admin Access)
    // ─────────────────────────────────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.clientId == request.auth.uid &&
          request.resource.data.clientId == resource.data.clientId &&
          (!('status' in request.resource.data) || request.resource.data.status == resource.data.status || request.resource.data.status == 'CLOSED')
        )
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.clientId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.resource.data.senderId == request.auth.uid &&
          (
            get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.clientId == request.auth.uid ||
            isAdmin()
          )
        );
        allow update, delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 15. conversations & messages Collections
    // 1-on-1 private messaging strictly restricted to legitimate bookings
    // ─────────────────────────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isAdmin()
      );

      // Clients can create conversation only if a legitimate booking exists connecting them
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.clientId == request.auth.uid &&
          request.resource.data.bookingId != null &&
          exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)) &&
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientId == request.auth.uid &&
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.trainerId == request.resource.data.trainerId
        )
      );

      // Only the client or trainer can update conversation metadata (last message, unread count)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.clientId == request.auth.uid || resource.data.trainerId == request.auth.uid) &&
          request.resource.data.clientId == resource.data.clientId &&
          request.resource.data.trainerId == resource.data.trainerId
        )
      );

      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.trainerId == request.auth.uid
        );

        allow create: if isAuthenticated() && (
          isAdmin() ||
          (
            request.resource.data.senderId == request.auth.uid &&
            (
              get(/databases/$(database)/documents/conversations/$(convId)).data.clientId == request.auth.uid ||
              get(/databases/$(database)/documents/conversations/$(convId)).data.trainerId == request.auth.uid
            )
          )
        );

        allow update: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.trainerId == request.auth.uid
        );

        allow delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 16. trainer_certificates Collection (Section 3 & 4: Private Certificates)
    // Strictly accessible to Trainer owner and Admin. Clients have zero access.
    // ─────────────────────────────────────────────────────────────────────────
    match /trainer_certificates/{certId} {
      allow read: if isAuthenticated() && (
        resource.data.trainerId == request.auth.uid || isAdmin()
      );

      // Trainers can upload certificates for Admin review.
      // Must start with PENDING or NOT_SUBMITTED status (prevent frontend self-approval).
      allow create: if isAuthenticated() && (
        isAdmin() || (
          request.resource.data.trainerId == request.auth.uid &&
          (request.resource.data.verificationStatus == 'PENDING' ||
           request.resource.data.verificationStatus == 'NOT_SUBMITTED')
        )
      );

      // Trainers can update their certificates or replace rejected documents (resets to PENDING).
      // Trainers CANNOT self-approve (cannot set status to VERIFIED/APPROVED).
      // Verified certificates cannot be modified by trainers (audit protection).
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.trainerId == request.auth.uid &&
          request.resource.data.trainerId == request.auth.uid &&
          resource.data.verificationStatus != 'VERIFIED' &&
          resource.data.verificationStatus != 'APPROVED' &&
          (request.resource.data.verificationStatus == 'PENDING' ||
           request.resource.data.verificationStatus == resource.data.verificationStatus)
        )
      );

      // Verified certificates cannot be deleted by trainers (prevents accidental deletion
      // of documents required for audit purposes). Only Admins can delete verified certificates.
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.trainerId == request.auth.uid &&
        resource.data.verificationStatus != 'VERIFIED' &&
        resource.data.verificationStatus != 'APPROVED'
      );
    }
  }
}


